# Example environment for the public demo stand.
# Copy to the server outside Git history, for example:
#   cp deploy/demo/.env.example .env
#   chmod 600 .env

APP_ENV=demo
APP_DEBUG=false

POSTGRES_DB=ticket_system
POSTGRES_USER=ticket_system
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://ticket_system:change_me@postgres:5432/ticket_system

JWT_SECRET_KEY=change_me_to_a_long_random_value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=180

BACKEND_PORT=18000
FRONTEND_PORT=15173
BACKEND_CORS_ORIGINS=https://example.org
VITE_API_BASE_URL=/api
VITE_ALLOWED_HOSTS=example.org,localhost,127.0.0.1

NOTIFICATION_PROVIDER=mock
MAX_API_BASE_URL=
MAX_BOT_TOKEN=
