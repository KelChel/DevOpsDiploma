# Application
APP_NAME=devops-ticket-system
APP_ENV=local
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ticket_system
POSTGRES_USER=ticket_system
POSTGRES_PASSWORD=change_me_for_local_only
DATABASE_URL=postgresql+asyncpg://ticket_system:change_me_for_local_only@postgres:5432/ticket_system

# Auth
JWT_SECRET_KEY=replace_with_local_development_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Notifications
NOTIFICATION_PROVIDER=mock
MAX_API_BASE_URL=
MAX_BOT_TOKEN=

